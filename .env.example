# Server-side only. Never prefix with VITE_ (that would expose it to the browser).
# Put each comment on its own line (do not add comments after a value).

# gemini (default) or anthropic
AI_PROVIDER=gemini

# Gemini: get a key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Confirm the current model name at https://ai.google.dev/gemini-api/docs/models
# (gemini-2.5-flash is restricted for new users and returns 404)
GEMINI_MODEL=gemini-3.8-flash

# Optional alternative: Anthropic Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Frontend origin(s) allowed to call this API when hosted separately (comma-separated, no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173

PORT=8787
