{
  "name": "medlens-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --env-file=.env server/index.js",
    "start": "node server/index.js",
    "test": "node tests/extract.test.mjs && node tests/ai-guard.test.mjs && node tests/preprocess.test.mjs && node tests/proxy.test.mjs && node tests/vercel-api.test.mjs",
    "check:ai": "node --env-file=.env server/check-ai.js",
    "test:samples": "node tests/ocr-samples.mjs",
    "eval:preprocess": "python3 tests/preprocess-eval/make_variants.py /tmp/ev && node tests/preprocess-eval/run.mjs /tmp/ev"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "vite": "^5.4.8"
  }
}